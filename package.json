{
  "name": "litvm-liteforge-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CLI automation bot for LitVM LiteForge testnet tasks.",
  "bin": {
    "bot": "./dist/cli.js"
  },
  "scripts": {
    "bot": "node --import tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "install:browsers": "playwright install chromium",
    "install:browsers:with-deps": "playwright install --with-deps chromium",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "pino": "^9.6.0",
    "playwright": "^1.59.1",
    "viem": "^2.21.54",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
